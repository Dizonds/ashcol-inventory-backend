{
  "name": "ashcol-inventory-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "bootstrap": "node scripts/setup/bootstrap.js",
    "seed:demo-accounts": "node scripts/seed-demo-accounts.js",
    "seed:demo-two-months": "node scripts/demo/seed-two-month-demo.js",
    "migrate:service-vans": "node scripts/migrations/migrate-service-vans.js",
    "migrate:job-links": "node scripts/migrations/migrate-job-links.js",
    "migrate:catalog-links": "node scripts/migrations/migrate-catalog-links.js",
    "migrate": "node scripts/migrations/migrate.js",
    "test": "node --test --test-concurrency=1 test/brandLogos.test.js test/liveUpdates.test.js test/inventory.test.js test/twoMonthDemo.test.js",
    "test:browser": "node scripts/qa/qa-smoke.js",
    "test:live": "node scripts/qa/live-updates-smoke.js",
    "test:qa": "node scripts/qa/qa-smoke.js && node scripts/qa/request-fulfillment-smoke.js && node scripts/qa/job-orders-smoke.js && node scripts/qa/live-updates-smoke.js",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "playwright-core": "^1.51.1",
    "supertest": "^7.3.1"
  },
  "private": true,
  "description": "Express and MongoDB API for ASHCOL inventory and service operations.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
